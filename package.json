{
  "name": "retro-ranker-app",
  "version": "1.0.7",
  "main": "expo-router/entry",
  "scripts": {
    "generate:icons": "node scripts/generate-app-icon.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "expo prebuild --clean",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android",
    "publish:android": "eas submit --platform android",
    "build:ios": "eas build --platform ios --profile production",
    "publish:ios": "eas submit --platform ios",
    "update": "eas update",
    "update:development": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "update:development:patch": "eas update --channel development --message \"Patch\"",
    "update:preview:patch": "eas update --channel preview --message \"Patch\"",
    "update:production:patch": "eas update --channel production --message \"Patch\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "expo": "~54.0.32",
    "expo-charts": "^1.0.2",
    "expo-constants": "^18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.22",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "native-base": "^3.4.28",
    "pocketbase": "^0.26.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.1.0",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "private": true
}
